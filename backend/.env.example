PORT=5000
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/assignment_reminder?retryWrites=true&w=majority
SESSION_SECRET=your_random_session_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Automatic Email Notification Service (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_character_gmail_app_password

# Automated Reminder Test Mode (Set to true to test with short delay instead of waiting 3 hours)
REMINDER_TEST_MODE=true
# Configurable short delay in minutes for test reminders (e.g. 1 minute)
REMINDER_TEST_DELAY_MINUTES=1
